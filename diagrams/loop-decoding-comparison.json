    { "id": "ls-pipe", "lane": "loopspec", "col": 2, "type": "messagebus", "label": "单 Token 逐层入管", "sublabel": "前序节点先到起草深度", "width": 176 },
    { "id": "ls-gate", "lane": "loopspec", "col": 4, "type": "security", "label": "更深层门控", "sublabel": "更新提案；错误时重启", "width": 176 },
    { "id": "ls-verify", "lane": "loopspec", "col": 5, "type": "security", "label": "全深度决定输出", "sublabel": "接受匹配并复用状态", "width": 176 },

    { "id": "la-draft", "lane": "loopahead", "col": 0, "type": "backend", "label": "LAD 多 Token 草稿", "sublabel": "浅层上下文＋原生 Anchor", "tag": "需训练", "width": 176 },
    { "id": "la-tree", "lane": "loopahead", "col": 2, "type": "messagebus", "label": "候选树递归扩展", "sublabel": "未验证草稿也能继续起草", "width": 176 },
    { "id": "la-feedback", "lane": "loopahead", "col": 4, "type": "security", "label": "中层反馈调度", "sublabel": "冲突暂停／恢复＋执行预算", "width": 176 },
    { "id": "la-verify", "lane": "loopahead", "col": 5, "type": "security", "label": "全深度决定输出", "sublabel": "提交前缀并剪除竞争枝", "width": 176 },

    { "id": "lf-draft", "lane": "loopfill", "col": 0, "type": "database", "label": "后缀树＋浅层预测", "sublabel": "检索多 Token；模型补草稿", "tag": "免训练", "width": 176 },
    { "id": "lf-tree", "lane": "loopfill", "col": 2, "type": "messagebus", "label": "统一树双向扩展", "sublabel": "多 Token 同批跨深度推进", "width": 176 },
