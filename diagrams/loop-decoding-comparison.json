      "title": "LoopSpec：最简洁",
      "items": ["浅层逐 Token 起草，完全免训练", "新 Token 启动受浅层深度与拒绝重启限制"]
    },
    {
      "dot": "violet",
      "title": "LoopAhead：草稿与调度协同",
      "items": ["LAD 提前铺长候选，中层反馈减少无效计算", "代价是模型相关训练与调度配置"]
    },
    {
      "dot": "emerald",
      "title": "LoopFill：检索与模型互补",
      "items": ["后缀树立即铺长，浅层预测补检索缺口", "共同原则：草稿管调度，全深度管输出"]
    }
  ]
