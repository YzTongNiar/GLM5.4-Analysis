    { "id": "la-draft-tree", "from": "la-draft", "to": "la-tree", "label": "一次起草 K 个", "variant": "default" },
    { "id": "la-tree-feedback", "from": "la-tree", "to": "la-feedback", "label": "中间层读数", "variant": "default" },
    { "id": "la-feedback-verify", "from": "la-feedback", "to": "la-verify", "label": "最终验证", "variant": "emphasis" },

    { "id": "lf-draft-tree", "from": "lf-draft", "to": "lf-tree", "label": "合并同前缀节点", "variant": "emphasis" },
    { "id": "lf-tree-prune", "from": "lf-tree", "to": "lf-prune", "label": "统一打分", "variant": "default" },
    { "id": "lf-prune-verify", "from": "lf-prune", "to": "lf-verify", "label": "最终验证", "variant": "emphasis" }
  ],
  "cards": [
    {
